# MongoDB Atlas (server-only)
MONGODB_URI=mongodb+srv://<database-user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=najeema_portfolio

# Cloudinary (server-only; never use NEXT_PUBLIC_ for the secret)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin login (use a unique, strong password)
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Gmail through Nodemailer
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=
